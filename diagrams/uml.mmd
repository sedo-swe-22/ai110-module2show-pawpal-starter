classDiagram
    class Owner {
        -String name
        -int availableMinutes
        -List~Pet~ pets
        +addPet(pet) void
    }

    class Pet {
        -String name
        -String breed
        -List~Task~ tasks
        +addTask(task) void
        +editTask(title, updates) void
        +removeTask(title) void
    }

    class Task {
        -String title
        -int durationMinutes
        -String priority
        -String preferredTime
        -String frequency
        -Pet pet
        -String scheduledTime
        -String reason
    }

    class Scheduler {
        +generateSchedule(owner) List~Task~
        +displaySchedule(tasks) void
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads
    Scheduler ..> Task : schedules
